generator client {
  provider = "prisma-client-js"
  output   = "../generated/client-v3"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CreditApplication {
  orderId Int? @unique
  order Order? @relation(fields: [orderId], references: [id])
  number Int @unique @default(autoincrement())
  id String @id @default(uuid())
  requestKey String @unique
  requestHash String
  firstName String
  lastName String
  fatherName String
  phone String
  fin String
  hasSima Boolean
  items Json
  total Float
  status String @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([createdAt])
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String?
  lastName  String?
  birthDate DateTime? @db.Date
  name      String
  email     String   @unique
  phone     String?  @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())

  orders     Order[]
  carts      Cart[]
  favourites Favourite[]
  compares   Compare[]
  chatSessions ChatSession[]
  otpChallenges OtpChallenge[]
  campaignEntries CampaignEntry[]
  qrScans QrScan[]
}

model OtpChallenge {
  id             Int       @id @default(autoincrement())
  phone          String
  status         String    @default("sent")
  registrationUsedAt DateTime?
  codeHash       String
  purpose        String    @default("login")
  sentAt         DateTime?
  providerId     String?
  attempts       Int       @default(0)
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())
  userId         Int?
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, createdAt])
  @@index([expiresAt])
}

model ChatSession {
  id        Int      @id @default(autoincrement())
  chatKey   String   @unique
  userId    Int?
  name      String
  phone     String
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages  ChatMessage[]
  @@index([updatedAt])
  @@index([userId])
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  sessionId Int
  sender    String
  text      String
  createdAt DateTime @default(now())
  readAt    DateTime?
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId, createdAt])
}

model Product {
  sortPosition Int @default(2147483647)
  id          Int      @id @default(autoincrement())
  name        String
  nameRu      String
  description String
  descRu      String
  price       Float
  image       String?
  category    String
  subcategory String?
  brand       String?
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  seoTitle    String? @db.VarChar(200)
  seoDescription String? @db.VarChar(500)
  colors      String?
  discount    String?
  installment String?
  oldPrice    Float?
  specs       Json?

  orderItems OrderItem[]
  carts      Cart[]
  favourites Favourite[]
  compares   Compare[]
  homeSections HomeSectionProduct[]
  placements ProductPlacement[]
  images     ProductImage[]
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  filename  String
  mimeType  String
  data      Bytes
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductPlacement {
  id          Int     @id @default(autoincrement())
  productId   Int
  category    String
  subcategory String?
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, category, subcategory])
  @@index([category, subcategory])
}

model Order {
  requestKey String? @unique
  requestHash String?
  paymentMethod String?
  deliveryDate String? @db.VarChar(10)
  address String?
  shippingFee Float @default(0)
  cancellationReason String?
  cancelledAt DateTime?
  deliveredAt DateTime?
  returnReason String?
  returnRequestedAt DateTime?
  creditApplication CreditApplication?
  id        Int      @id @default(autoincrement())
  userId    Int
  status    String   @default("pending")
  total     Float
  createdAt DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]
}

model OrderItem {
  name String?
  color String?
  id        Int   @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Float

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Cart {
  id        Int @id @default(autoincrement())
  userId    Int
  productId Int
  quantity  Int @default(1)

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Favourite {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Compare {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model HomeSection {
  id Int @id @default(autoincrement())
  name String @db.VarChar(120)
  active Boolean @default(true)
  position Int @default(0)
  products HomeSectionProduct[]
  @@index([position, id])
}

model HomeSectionProduct {
  sortPosition Int @default(2147483647)
  sectionId Int
  productId Int
  section HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([sectionId, productId])
  @@index([productId])
}

model Brand {
  id Int @id @default(autoincrement())
  name String @unique
  image String?
  logoData Bytes?
  logoMime String?
  active Boolean @default(false)
  position Int @default(1000)
}

model Campaign {
  id Int @id @default(autoincrement())
  name String
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamp(3)
  sources QrSource[]
  entries CampaignEntry[]
}

model QrSource {
  id String @id
  campaignId Int
  name String
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamp(3)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scans QrScan[]
}

model QrScan {
  id String @id
  sourceId String
  visitId String
  userId Int?
  device String
  browser String
  os String
  status String @default("scanned")
  createdAt DateTime @default(now()) @db.Timestamp(3)
  source QrSource @relation(fields: [sourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  entry CampaignEntry?
  @@unique([sourceId, visitId], map: "QrScan_sourceId_visitId_key")
  @@index([sourceId, createdAt])
  @@index([userId])
}

model CampaignRetiredNumber {
  number BigInt @id
  retiredAt DateTime @default(now()) @db.Timestamp(3)
}

model CampaignEntry {
  id Int @id @default(autoincrement())
  campaignId Int
  userId Int?
  scanId String @unique
  finHash String
  finMasked String
  finEncrypted String?
  number BigInt @unique
  status String @default("active")
  createdAt DateTime @default(now()) @db.Timestamp(3)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  scan QrScan @relation(fields: [scanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@unique([campaignId, finHash], map: "CampaignEntry_campaignId_finHash_key")
  @@unique([campaignId, userId], map: "CampaignEntry_campaignId_userId_key")
  @@index([campaignId, createdAt])
}

model CampaignCounter {
  id Int @id
  value BigInt @default(0)
}

model CampaignConfig {
  id Int @id
  keyFingerprint String
}

model CampaignRateLimit {
  key String @id
  count Int
  expiresAt DateTime @db.Timestamp(3)
  @@index([expiresAt])
}

model QrCampaignMigration {
  name String @id
  checksum String
  appliedAt DateTime @default(now()) @db.Timestamp(3)
}
